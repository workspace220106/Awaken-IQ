# Copy to .env for local development. In production set these in Vercel > Project > Settings > Environment Variables.

# Random 32+ byte string. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Management console login (choose a long password; there is no other admin account)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Razorpay (use rzp_live_* keys in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Admin service-account JSON, as a single line
FIREBASE_SERVICE_ACCOUNT=

# Google Drive service-account JSON, as a single line
GOOGLE_DRIVE_CREDENTIALS=
# Drive folder that holds all student folders and DMIT reports (share it with the Drive service account as Editor)
DRIVE_PARENT_FOLDER_ID=19SlDbrSRTabzTe9uAfnkLbqZdaIwZq-Z

# Optional: Zoom Meeting SDK, for the embedded "Join in browser" experience
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# Razorpay webhook (Dashboard -> Settings -> Webhooks -> URL https://<your-domain>/api/razorpay-webhook, events payment.captured + order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Public origin used in password-reset emails (defaults to the Vercel production URL)
APP_URL=

# Outgoing email for password resets. Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465, SMTP_PASS = a Google "App password"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Awaken IQ <no-reply@awakeniq.com>"
