# Copy to .env for local development. In production set these in Vercel > Project > Settings > Environment Variables.

# Random 32+ byte string. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Management console login (choose a long password; there is no other admin account)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Razorpay (use rzp_live_* keys in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Admin service-account JSON, as a single line
FIREBASE_SERVICE_ACCOUNT=

# Google Drive service-account JSON, as a single line
GOOGLE_DRIVE_CREDENTIALS=
# Drive folder that holds all student folders and DMIT reports (the service account must have edit access)
DRIVE_PARENT_FOLDER_ID=

# Optional: Zoom Meeting SDK, for the embedded "Join in browser" experience
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
